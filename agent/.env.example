APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

AI_PROVIDER=deepseek

# Required when AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Text model used for routing and agent runs. Supported: deepseek-flash, deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

AGENT_BASE_URL=http://localhost:4500/webhooks/events
AGENT_API_TOKEN=
AGENT_WORKSPACE=/tmp/goravel-agent
# Required, e.g. AGENT_ALLOWED_SENDERS=bowen
AGENT_ALLOWED_SENDERS=
# Handle that triggers an agent run, e.g. `@goravel-agent review`. Blank uses the
# built-in default.
AGENT_MENTION=@goravel-agent
