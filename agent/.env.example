APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

AI_PROVIDER=deepseek

# Required when AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Text model used for routing and agent runs. Supported: deepseek-flash, deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

AGENT_BASE_URL=http://localhost:4500/webhooks/events
AGENT_API_TOKEN=
# Paseo project every run workspace is created in: the workspace points at the
# project's folder, so every run starts there and the run's `setup` subagent
# clones the repository inside it. That folder is shared state — every run of a
# repository reuses one checkout below it — so point this at a directory private
# to the agent's user. Resolved from this name with `paseo project ls` the first
# time a mention needs a workspace. There is no default: a blank value is a
# configuration error and stops `poll-events` before it polls. Each run's setup
# step clones over SSH (git@github.com:).
AGENT_PROJECT_NAME=tmp
# Required, e.g. AGENT_ALLOWED_SENDERS=bowen
AGENT_ALLOWED_SENDERS=
# Handle that triggers an agent run, e.g. `@goravel-agent review`. Blank uses the
# built-in default.
AGENT_MENTION=@goravel-agent

# GitHub token used to add the 👀 reaction to a mention. Blank disables
# reactions. A fine-grained token needs `issues: write` for issue and pull
# request conversation comments and `pull-requests: write` for inline review
# comments and review bodies (a review is reacted through GitHub's GraphQL API,
# the only API where a pull request review is reactable); a classic token needs
# `repo`.
GITHUB_TOKEN=
